# Keep your existing MongoDB, JWT, Groq and Sarvam settings too.
PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/medicall
JWT_SECRET=replace_with_a_long_random_secret
GROQ_API_KEY=your_groq_api_key
SARVAM_API_KEY=your_sarvam_api_key
CLIENT_URL=http://localhost:5173

# Gmail SMTP settings for appointment emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourclinicgmail@gmail.com
SMTP_PASS=your_16_character_google_app_password
MAIL_FROM=MediCall AI <yourclinicgmail@gmail.com>

# Razorpay TEST keys (replace with LIVE keys only after testing)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret